{
  "name": "mermaid-markdown-visualizer",
  "version": "2.1.0",
  "description": "Mermaid & Markdown Visualizer – Viewer, Editor und PDF-Export für Markdown, Mermaid-Diagramme und Code-Dateien unter Windows",
  "productName": "Mermaid & Markdown Visualizer",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dev:example": "electron . test/example.md",
    "dev:diagram": "electron . test/example.mmd",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run test:e2e",
    "icon": "node scripts/generate-icon.js",
    "vendor": "node scripts/vendor-mermaid.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir"
  },
  "author": "SebazzProductions",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "js-beautify": "^2.0.3",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "prettier": "^3.10.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "mermaid": "^11.17.2",
    "playwright": "^1.65.0"
  },
  "homepage": "https://github.com/SebazzProductions/Windows-Markdown-Visualizer_By_SebazzProductions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebazzProductions/Windows-Markdown-Visualizer_By_SebazzProductions.git"
  },
  "bugs": {
    "url": "https://github.com/SebazzProductions/Windows-Markdown-Visualizer_By_SebazzProductions/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
